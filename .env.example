# Velora environment configuration (copy to .env; never commit real secrets).
# Settings can also be overridden via VELORA_<SECTION>__<KEY> variables.

# --- AI provider (optional) ---
# provider: heuristic (offline, default) | null | openai_compatible
VELORA_AI__PROVIDER=heuristic
# For an external OpenAI-compatible LLM, set the provider and supply the key:
# VELORA_AI__PROVIDER=openai_compatible
# VELORA_AI__MODEL=gpt-4o-mini
# VELORA_AI__BASE_URL=https://api.openai.com/v1
# The API key is read ONLY from the environment, never stored:
# VELORA_AI_API_KEY=sk-...

# --- Dashboard / API ---
VELORA_API__HOST=127.0.0.1
VELORA_API__PORT=8787

# --- Logging ---
VELORA_LOGGING__LEVEL=INFO
# VELORA_LOGGING__JSON_FILE=/var/log/velora/audit.jsonl

# --- Storage locations ---
# VELORA_DATA_DIR=~/.local/share/velora
# VELORA_CONFIG_DIR=~/.config/velora
